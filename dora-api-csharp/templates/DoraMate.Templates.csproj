<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DoraMate.Templates</PackageId>
    <Version>0.2.0</Version>
    <Title>DoraMate C# Templates</Title>
    <Authors>DoraMate Contributors</Authors>
    <Description>dotnet new templates for creating Dora nodes and operators in C#.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dora-rs/dora</PackageProjectUrl>
    <PackageTags>dotnet-new;templates;dora;dataflow</PackageTags>

    <!-- Template pack contract -->
    <PackageType>Template</PackageType>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <!-- Dummy build: templates are content-only -->
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="dora-node\**\*" Exclude="dora-node\**\bin\**;dora-node\**\obj\**" />
    <Content Include="dora-operator\**\*" Exclude="dora-operator\**\bin\**;dora-operator\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
