{
  "$schema": "http://json.schemastore.org/template",
  "author": "DoraMate",
  "classifications": ["Dora", "Dataflow", "Node"],
  "identity": "DoraMate.DoraNode.Template",
  "name": "Dora Node (C#)",
  "shortName": "dora-node",
  "description": "A minimal C# Dora node project that connects to the Dora runtime and processes events.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CSharpNode",
  "preferNameDirectory": true,
  "symbols": {
    "NodeName": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "MyDoraNode",
      "displayName": "Node class name",
      "description": "The name of the entry-point class / namespace.",
      "defaultValue": "MyDoraNode"
    },
    "TargetFramework": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "net8.0",
      "displayName": "Target framework",
      "description": "The .NET target framework moniker.",
      "defaultValue": "net8.0",
      "choices": [
        { "choice": "net8.0", "description": ".NET 8.0" },
        { "choice": "net9.0", "description": ".NET 9.0" }
      ]
    }
  }
}